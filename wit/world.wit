package demo:db;

// The Rust host and client components already use
// this interface successfully. The Go component
// will use it without importing wasm-sql directly.
// Try TinyGo’s built-in WIT support, not the old
// standalone wit-bindgen go command. TinyGo sup-
// ports WASI Preview 2 components directly with
// -target wasip2, -wit-package, and -wit-world 

interface database {
    record query-result {
        columns: list<string>,
        rows: list<list<string>>,
    }

    execute: func(sql: string) -> result<u64, string>;
    query: func(sql: string) -> result<query-result, string>;
}

interface application {
    run: func() -> string;
}

world app {
    import database;
    export application;
}
