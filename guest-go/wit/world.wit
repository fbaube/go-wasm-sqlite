package demo:db;

interface database {
    record query-result {
        columns: list<string>,
        rows: list<list<string>>,
    }

    execute: func(sql: string) -> result<u64, string>;
    query: func(sql: string) -> result<query-result, string>;
}

interface application {
    run: func() -> string;
}

world app {
    include wasi:cli/imports@0.2.0;
    import database;
    export application;
}
