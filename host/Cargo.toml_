[package]
name = "wasi_sql_demo_host"
version = "0.1.0"
edition = "2021"

[dependencies]
anyhow = "1"
tokio = { version = "1", features = ["full"] }
wasmtime = { version = "26", features = ["component-model", "async"] }
wasmtime-wasi = "26"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
